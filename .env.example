# Application
APP_NAME=grounded-rag-assistant
APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
# Log format: "json" (structured, one object per line, includes trace ids) or
# "text" (plain lines).
LOG_FORMAT=json

# Elasticsearch
# Local docker-compose service URL. Elasticsearch is self-hosted and runs as a
# single node with security disabled for development.
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=rag_chunks

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=grounded_rag
POSTGRES_USER=grounded_rag
POSTGRES_PASSWORD=grounded_rag

# Embeddings
# Phase 0 only wires configuration. Later phases will load this model locally
# via sentence-transformers; no embedding API key is required.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Retrieval (Phase 2)
# Default number of results returned by /search and used during hybrid fusion.
RETRIEVAL_K=10
# Reciprocal Rank Fusion tuning. rank_constant dampens lower ranks; rank_window
# is how deep each method is fused before the top-k is taken.
RRF_RANK_CONSTANT=60
RRF_RANK_WINDOW=50
# Optional local cross-encoder reranking. When enabled, the fused top
# RERANK_CANDIDATE_POOL chunks are rescored and the top k returned. The model is
# downloaded locally on first use (no API, no key).
RERANK_ENABLED=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATE_POOL=50

# Evaluation (Phase 4)
EVAL_K=10
EVAL_GOLD_PATH=data/gold/queries.jsonl
EVAL_REPORT_DIR=eval_reports
# Regression guard: hybrid MRR must stay at or above this (baseline ~0.97).
EVAL_HYBRID_MRR_THRESHOLD=0.9
# Max answerable/non-answerable gold items sent to the LLM during answer eval.
# Set 0 to disable answer eval (retrieval metrics still run). Answer eval is
# skipped automatically when no LLM provider is available (e.g. in CI).
EVAL_ANSWER_SAMPLE=6

# Observability (Phase 6)
# OpenTelemetry tracing. When the OTLP endpoint is empty, spans are printed to
# the console exporter. Point it at the Jaeger OTLP/HTTP port to ship traces:
#   docker compose --profile tracing up -d
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_SERVICE_NAME=grounded-rag-assistant
OTEL_TRACES_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=

# Generation
# Supported values: gemini, ollama. Default is gemini for free-tier usage.
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1
