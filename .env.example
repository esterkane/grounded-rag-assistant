# =============================================================================
# grounded-rag-assistant — example environment configuration
#
# Copy to .env and adjust. The defaults match the local Docker Compose stack,
# so for a local run you only need to set GEMINI_API_KEY (or switch to ollama).
#   cp .env.example .env
# .env is git-ignored; never commit real secrets.
# =============================================================================

# --- General -----------------------------------------------------------------
# Free-form environment name and Python log level.
APP_ENV=local
LOG_LEVEL=INFO

# --- Elasticsearch -----------------------------------------------------------
# BM25 + vector search live in the same single-node ES (pinned to 9.4.1).
# Host-run process: http://localhost:9200
# Inside Docker Compose the api service overrides this to http://elasticsearch:9200.
ES_URL=http://localhost:9200
# Index that holds chunk documents (created in Phase 1).
ES_INDEX=rag_chunks

# --- PostgreSQL --------------------------------------------------------------
# Application data (query logs, feedback — added in Phase 5).
# Host-run process uses localhost; in Compose the api service sets POSTGRES_HOST=postgres.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=grag
POSTGRES_PASSWORD=grag
POSTGRES_DB=grag

# --- Embeddings (Phase 1) ----------------------------------------------------
# Local sentence-transformers model. No API key needed; downloaded on first use.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- LLM generation (Phase 3) ------------------------------------------------
# Provider-abstracted. Options: "gemini" (free tier) or "ollama" (fully local).
LLM_PROVIDER=gemini

# Gemini (Google AI Studio free tier). Required only when LLM_PROVIDER=gemini.
# Get a free key (no card) at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Ollama (local). Required only when LLM_PROVIDER=ollama.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Retrieval (Phase 2) -----------------------------------------------------
# Toggle the optional local cross-encoder reranker. Off by default.
RERANK_ENABLED=false
